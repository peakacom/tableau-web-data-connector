{
  "name": "peaka-web-data-connector",
  "version": "1.0.3",
  "description": "Peaka Web Data Connector Implementation",
  "scripts": {
    "prebuild": "taco-scripts clean",
    "test": "node --test ../scripts/*.test.*",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "run-s build:*",
    "build:css": "tailwindcss -m -i ./app/styles/input/app.css -o app/styles/output/app.css",
    "build:taco": "taco-scripts build",
    "clean": "taco-scripts clean",
    "start": "taco-scripts start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakacom/tableau-web-data-connector.git"
  },
  "keywords": [
    "tableau",
    "peaka"
  ],
  "author": "ibrahim gurses",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/peakacom/tableau-web-data-connector/issues"
  },
  "homepage": "https://github.com/peakacom/tableau-web-data-connector#readme",
  "targets": {
    "handlers": {
      "includeNodeModules": true,
      "sourceMap": false,
      "context": "web-worker",
      "distDir": "../dist/handlers",
      "outputFormat": "commonjs",
      "isLibrary": false,
      "optimize": false
    },
    "app": {
      "sourceMap": false,
      "publicUrl": "./",
      "distDir": "../dist/app",
      "engines": {
        "browsers": "Chrome 70"
      }
    }
  },
  "alias": {
    "process": false,
    "path": false,
    "util": false
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "^2.0.3",
    "@tableau/taco-toolkit": "^2.0.0",
    "lodash.template": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loader-spinner": "^6.1.6",
    "react-query": "^3.39.3",
    "react-toastify": "^10.0.4"
  },
  "devDependencies": {
    "@types/lodash.template": "^4.5.3",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
